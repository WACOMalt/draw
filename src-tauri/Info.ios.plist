<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the iOS app's Info.plist by `tauri ios build` (on top of the generated one and the
  .bdraw file association from tauri.conf.json).
-->
<plist version="1.0">
<dict>
  <!-- Saved .bdraw files and exports show in the Files app, under On My iPhone / iPad. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
  <!-- iPad: every orientation, Split View and Slide Over. -->
  <key>UIRequiresFullScreen</key>
  <false/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <!-- A trackpad or mouse on iPad sends pointer events (hover, right click). -->
  <key>UIApplicationSupportsIndirectInputEvents</key>
  <true/>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
