{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: native save dialog and writing the chosen file (PNG export, .bdraw save, large image export streamed in pieces).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-open",
    "fs:allow-write",
    "fs:allow-seek",
    "fs:allow-remove"
  ]
}
